// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MilestoneStatus {
  PENDING
  FUNDED
  SUBMITTED
  APPROVED
  REFUNDED
}

enum ProjectStatus {
  DRAFT
  ONCHAIN
}

model User {
  id        String   @id @default(cuid())
  walletAddress String @unique
  githubUsername String?
  // TODO: encrypt at rest before production; fine for hackathon MVP, scoped to read:user only.
  githubAccessToken String?
  createdAt DateTime @default(now())

  clientProjects      Project[]            @relation("ClientProjects")
  developerProjects   Project[]            @relation("DeveloperProjects")
  payments            Payment[]
  githubContributions GithubContribution[]
}

model GithubContribution {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userId], references: [id])
  userId       String
  repository   String
  prNumber     Int
  title        String
  status       String
  url          String
  createdAt    DateTime
  mergedAt     DateTime?
  filesChanged Int
  additions    Int
  deletions    Int
  language     String?
  fetchedAt    DateTime  @default(now())

  // AI Contribution Analyzer output — null until analyzed.
  aiCategory   String?
  aiSkills     String[]  @default([])
  aiComplexity String?
  aiImpact     String?
  aiSummary    String?
  analyzedAt   DateTime?

  @@unique([repository, prNumber])
}

// Repo-level GitHub traction, keyed by "owner/name" — not tied to a single developer,
// since multiple contributors can share a repository. Refreshed opportunistically
// whenever a GitHub contribution sync touches that repo.
model RepoImpact {
  id           String   @id @default(cuid())
  repository   String   @unique
  stars        Int
  forks        Int
  openIssues   Int
  contributors Int?
  fetchedAt    DateTime @default(now())
}

model Project {
  id            String        @id @default(cuid())
  // Set once the createProject tx confirms on-chain; null while still a draft.
  onchainId     BigInt?       @unique
  status        ProjectStatus @default(DRAFT)
  metadataURI   String        @unique

  title         String
  description   String?

  client        User   @relation("ClientProjects", fields: [clientId], references: [id])
  clientId      String
  developer     User   @relation("DeveloperProjects", fields: [developerId], references: [id])
  developerId   String

  milestones    Milestone[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Milestone {
  id              String          @id @default(cuid())
  project         Project         @relation(fields: [projectId], references: [id])
  projectId       String
  // Index within the project's on-chain milestoneAmounts array.
  index           Int
  description     String?
  amount          Decimal         @db.Decimal(18, 6)
  status          MilestoneStatus @default(PENDING)
  proofURI        String?

  payment         Payment?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([projectId, index])
}

model Payment {
  id            String    @id @default(cuid())
  milestone     Milestone @relation(fields: [milestoneId], references: [id])
  milestoneId   String    @unique
  developer     User      @relation(fields: [developerId], references: [id])
  developerId   String
  amount        Decimal   @db.Decimal(18, 6)
  txHash        String    @unique
  blockNumber   BigInt
  releasedAt    DateTime  @default(now())
}
